{
  "name": "tradelink-saas-v6",
  "private": true,
  "version": "6.0.0",
  "description": "TRADELINK V6.0 — Plateforme SaaS B2B de commerce, import-export, gestion, logistique, comptabilité et collaboration",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:backend": "tsx src/server/server.ts",
    "build": "vite build",
    "build:backend": "node -e \"require('esbuild').buildSync({ entryPoints: ['src/server/server.ts'], bundle: true, platform: 'node', target: 'node20', outfile: 'dist/server.cjs' })\"",
    "start:backend": "node dist/server.cjs",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc --noEmit",
    "test:express": "node scripts/run-test.cjs src/server/tests/express.server.test.ts",
    "test:backend": "node scripts/run-test.cjs src/server/tests/backend.integration.test.ts",
    "test:security": "node scripts/run-test.cjs src/server/tests/security.auth.test.ts",
    "test:kyc": "node scripts/run-test.cjs src/server/tests/kyc.module.test.ts",
    "test:commercial": "node scripts/run-test.cjs src/server/tests/commercial.workflow.test.ts",
    "test:logistics": "node scripts/run-test.cjs src/server/tests/logistics.workflow.test.ts",
    "test:accounting": "node scripts/run-test.cjs src/server/tests/accounting.module.test.ts",
    "test:ai": "node scripts/run-test.cjs src/server/tests/ai.ocr.room.test.ts",
    "test:admin": "node scripts/run-test.cjs src/server/tests/admin.advanced.test.ts",
    "test:i18n": "node scripts/run-test.cjs src/server/tests/i18n.rtl.test.ts",
    "test:e2e": "node scripts/run-test.cjs src/server/tests/e2e.playwright.test.ts",
    "test:security-audit": "node scripts/run-test.cjs src/server/tests/security.audit.sast.dast.test.ts",
    "test:performance": "node scripts/run-test.cjs src/server/tests/performance.bench.test.ts",
    "test:harmonisation": "node scripts/run-test.cjs src/server/tests/final.harmonisation.integration.test.ts",
    "test:translation": "node scripts/run-test.cjs src/server/tests/translation.engine.test.ts",
    "test:auth-lifecycle": "node scripts/run-test.cjs src/server/tests/auth.session.lifecycle.test.ts",
    "test:copilot": "node scripts/run-test.cjs src/server/tests/copilot.module.test.ts",
    "test:voice": "node scripts/run-test.cjs src/server/tests/voice.dictation.test.ts",
    "test:ocr": "node scripts/run-test.cjs src/server/tests/ocr.intelligence.test.ts",
    "test:room-live": "node scripts/run-test.cjs src/server/tests/room.live.test.ts",
    "test:notifications": "node scripts/run-test.cjs src/server/tests/notification.messaging.test.ts",
    "test:catalog": "node scripts/run-test.cjs src/server/tests/catalog.central.test.ts",
    "test:stock": "node scripts/run-test.cjs src/server/tests/stock.management.test.ts",
    "test:commercial-cycle": "node scripts/run-test.cjs src/server/tests/commercial.cycle.test.ts",
    "test:billing-documents": "node scripts/run-test.cjs src/server/tests/billing.documents.test.ts",
    "test:logistics-advanced": "node scripts/run-test.cjs src/server/tests/logistics.advanced.test.ts",
    "test:financial-engine": "node scripts/run-test.cjs src/server/tests/financial.engine.test.ts",
    "test:admin-security": "node scripts/run-test.cjs src/server/tests/admin.security.audit.test.ts",
    "test:support": "node scripts/run-test.cjs src/server/tests/support.helpdesk.test.ts",
    "test:search-analytics": "node scripts/run-test.cjs src/server/tests/search.analytics.test.ts",
    "test:global-validation": "node scripts/run-test.cjs src/server/tests/global.integration.validation.test.ts",
    "test:load": "k6 run scripts/load-test.k6.js",
    "test:all": "npm run test:backend && npm run test:security && npm run test:kyc && npm run test:commercial && npm run test:logistics && npm run test:logistics-advanced && npm run test:accounting && npm run test:financial-engine && npm run test:ai && npm run test:copilot && npm run test:voice && npm run test:ocr && npm run test:admin && npm run test:admin-security && npm run test:support && npm run test:search-analytics && npm run test:i18n && npm run test:translation && npm run test:room-live && npm run test:notifications && npm run test:catalog && npm run test:stock && npm run test:commercial-cycle && npm run test:billing-documents && npm run test:auth-lifecycle && npm run test:e2e && npm run test:security-audit && npm run test:performance && npm run test:harmonisation && npm run test:global-validation"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "decimal.js": "^10.4.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "i18next": "^27.1.5",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^18.0.2",
    "react-router-dom": "^6.28.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "prisma": "6.4.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
