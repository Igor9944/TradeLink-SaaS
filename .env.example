# ============================================================================
# TRADELINK V6.1 — MODÈLE DE VARIABLES D'ENVIRONNEMENT (.env.example)
# RÈGLE RÉGALIENNE : AUCUN SECRET BRUT NE DOIT ÊTRE ENGAGÉ EN CLAIR DANS GIT
# Générer chaque secret via : openssl rand -hex 32
# ============================================================================

# ----------------------------------------------------------------------------
# 1. ENVIRONNEMENT APPLICATIF & RÉSEAU
# ----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
FRONTEND_PORT=5173
HOST=0.0.0.0
APP_BASE_URL=https://app.tradelink.ma
CORS_ALLOWED_ORIGINS=https://app.tradelink.ma,https://admin.tradelink.ma

# ----------------------------------------------------------------------------
# 2. BASE DE DONNÉES POSTGRESQL 16 (PRISMA ORM)
# ----------------------------------------------------------------------------
POSTGRES_USER=tradelink_user
POSTGRES_PASSWORD=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET
POSTGRES_DB=tradelink_db
DATABASE_URL="postgresql://tradelink_user:REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET@postgres:5432/tradelink_db?schema=public&connection_limit=50&pool_timeout=20"

# ----------------------------------------------------------------------------
# 3. REDIS 7 (CACHE & SESSIONS UNIQUES - SINGLE ACTIVE SESSION POLICY)
# ----------------------------------------------------------------------------
REDIS_PASSWORD=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET
REDIS_URL="redis://:REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET@redis:6379/0"
SESSION_TTL_SECONDS=86400
OTP_EXPIRATION_SECONDS=600

# ----------------------------------------------------------------------------
# 4. GESTION DES CLÉS & CHIFFREMENT KMS (HASHICORP VAULT / HSM)
# Attention : Ne jamais définir VAULT_DEV_ROOT_TOKEN_ID en production
# ----------------------------------------------------------------------------
KMS_PROVIDER=HASHICORP_VAULT_KMS
KMS_VAULT_ADDR=http://vault:8200
KMS_VAULT_TOKEN=REPLACE_WITH_VAULT_PROD_TOKEN_MIN_32_CHARS
KMS_MASTER_KEY_ALIAS=alias/tradelink-prod-kek-v6
KMS_ALGORITHM=AES-256-GCM

# ----------------------------------------------------------------------------
# 5. STOCKAGE D'OBJETS COMPATIBLE S3 (MINIO / AWS S3) & SIGNATURES FICHIERS
# ----------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=eu-west-1
S3_ACCESS_KEY=REPLACE_WITH_S3_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET
S3_BUCKET_DOCS=tradelink-encrypted-documents
S3_BUCKET_BACKUPS=tradelink-encrypted-backups
ATTACHMENT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET
KYC_SIGNING_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET
OCR_HMAC_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET

# ----------------------------------------------------------------------------
# 6. PAIEMENTS EN LIGNE STRIPE
# ----------------------------------------------------------------------------
STRIPE_MODE=live
STRIPE_PUBLIC_KEY=REPLACE_WITH_STRIPE_PUBLIC_KEY
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET

# ----------------------------------------------------------------------------
# 7. SÉCURITÉ JWT, HACHAGE ARGON2ID, MFA TOTP & ROOM LIVE
# ----------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
MFA_ISSUER=TRADELINK_B2B
ROOM_ACCESS_TOKEN_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET

# ----------------------------------------------------------------------------
# 8. MONITORING, MÉTRIQUES & OBSERVABILITÉ (GRAFANA, SENTRY & PROMETHEUS)
# ----------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
PROMETHEUS_METRICS_ENABLED=true
METRICS_PORT=9090
