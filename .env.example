# ============================================================================
# TRADELINK V6.0 — MODÈLE DE VARIABLES D'ENVIRONNEMENT (.env.example)
# RÈGLE RÉGALIENNE : AUCUN SECRET BRUT NE DOIT ÊTRE ENGAGÉ EN CLAIR
# ============================================================================

# ----------------------------------------------------------------------------
# 1. ENVIRONNEMENT APPLICATIF & RÉSEAU
# ----------------------------------------------------------------------------
NODE_ENV=production
PORT=5173
HOST=0.0.0.0
APP_BASE_URL=https://app.tradelink.ma
CORS_ALLOWED_ORIGINS=https://app.tradelink.ma,https://admin.tradelink.ma

# ----------------------------------------------------------------------------
# 2. BASE DE DONNÉES POSTGRESQL 16 (PRISMA ORM)
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://tradelink_user:CHANGE_ME_IN_PRODUCTION@postgres:5432/tradelink_db?schema=public&connection_limit=50&pool_timeout=20"
POSTGRES_USER=tradelink_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=tradelink_db

# ----------------------------------------------------------------------------
# 3. REDIS 7 (CACHE & SESSIONS UNIQUES - SINGLE ACTIVE SESSION POLICY)
# ----------------------------------------------------------------------------
REDIS_URL="redis://:CHANGE_REDIS_PASSWORD@redis:6379/0"
REDIS_PASSWORD=CHANGE_REDIS_PASSWORD
SESSION_TTL_SECONDS=86400
OTP_EXPIRATION_SECONDS=600

# ----------------------------------------------------------------------------
# 4. GESTION DES CLÉS & CHIFFREMENT KMS (HASHICORP VAULT / HSM)
# ----------------------------------------------------------------------------
KMS_PROVIDER=HASHICORP_VAULT_KMS
KMS_VAULT_ADDR=http://vault:8200
KMS_VAULT_TOKEN=CHANGE_ME_VAULT_TOKEN
KMS_MASTER_KEY_ALIAS=alias/tradelink-prod-kek-v6
KMS_ALGORITHM=AES-256-GCM

# ----------------------------------------------------------------------------
# 5. STOCKAGE D'OBJETS COMPATIBLE S3 (MINIO / AWS S3)
# ----------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=eu-west-1
S3_ACCESS_KEY=tradelink_s3_admin
S3_SECRET_KEY=CHANGE_S3_SECRET_KEY
S3_BUCKET_DOCS=tradelink-encrypted-documents
S3_BUCKET_BACKUPS=tradelink-encrypted-backups

# ----------------------------------------------------------------------------
# 6. PAIEMENTS EN LIGNE STRIPE (MODE TEST AVANT PRODUCTION)
# ----------------------------------------------------------------------------
STRIPE_MODE=test
STRIPE_PUBLIC_KEY=pk_test_sample_tradelink_v6
STRIPE_SECRET_KEY=sk_test_sample_tradelink_v6_secret
STRIPE_WEBHOOK_SECRET=whsec_sample_tradelink_v6_webhook

# ----------------------------------------------------------------------------
# 7. SÉCURITÉ JWT, HACHAGE ARGON2ID & MFA TOTP
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET=CHANGE_JWT_SUPER_SECRET_MIN_64_CHARS_RANDOM_HEX
JWT_REFRESH_SECRET=CHANGE_REFRESH_SUPER_SECRET_MIN_64_CHARS_RANDOM_HEX
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
MFA_ISSUER=TRADELINK_B2B

# ----------------------------------------------------------------------------
# 8. MONITORING, MÉTRIQUES & OBSERVABILITÉ (SENTRY & PROMETHEUS)
# ----------------------------------------------------------------------------
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
PROMETHEUS_METRICS_ENABLED=true
METRICS_PORT=9090
